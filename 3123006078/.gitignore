# 根目录默认全部忽略，只保留两个查重程序目录和单元测试目录。
/*

# .gitignore 自身必须保留，否则 Git 无法读取这些规则。
!/.gitignore

# 原来的 3-gram 查重程序
!/plagiarism_checker/
!/plagiarism_checker/**

# Ratcliff/Obershelp 查重程序
!/plagiarism_checker_ratcliff_obershelp/
!/plagiarism_checker_ratcliff_obershelp/**

# 单元测试项目
!/UnitTest1/
!/UnitTest1/**

# 小学四则运算程序
!/four_arithmetic/
!/four_arithmetic/**

# 本地测试生成的答案文件
ans_test.txt
